{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myrenting-staging",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "myrenting.es", "custom_domain": true },
    { "pattern": "www.myrenting.es", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "database_name": "myrenting-reviews-staging",
      "database_id": "e1cb63b5-63d4-4d8a-84a8-2a555b7e092d"
    }
  ],
  "observability": {
    "enabled": true
  }
}
